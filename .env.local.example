# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...

# Google AI (Gemini — 입지 분석 요약)
GOOGLE_AI_API_KEY=your-google-ai-api-key

# 카카오맵 (입지 분석 + 지도 렌더링)
NEXT_PUBLIC_KAKAO_MAP_API_KEY=your-kakao-javascript-key
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# 통계청 SGIS (거주인구 추정)
# https://sgis.kostat.go.kr/developer/html/newOpenApi/api/dataApi.html
SGIS_SERVICE_ID=your-sgis-service-id
SGIS_SECURITY_KEY=your-sgis-security-key

# 세움터 OpenAPI
SEUMTEO_API_KEY=your-seumteo-api-key
SEUMTEO_API_URL=https://apis.data.go.kr/1613000

# 공공데이터포털 건축물대장
PUBLIC_DATA_API_KEY=your-public-data-api-key

# 소상공인 상가정보 (점포·업종 구성·상권 경계)
# https://www.data.go.kr/data/15012005/openapi.do
# 주의: 현행 공식 명세에 매출·유동인구 작업은 없다.
COMMERCIAL_API_KEY=your-soho-commercial-api-key

# ── 무료 공공 데이터 레이어 ───────────────────────────────────
# 서울시 열린데이터광장 일반 인증키 (실시간 상권현황 citydata_cmrcl)
# https://data.seoul.go.kr/dataList/OA-22385/A/1/datasetView.do
# 공공누리 1유형 · 10분 갱신 · 서울 주요 82곳 · 금액은 구간값만 공개
SEOUL_OPENAPI_KEY=your-seoul-openapi-key

# 한국조폐공사 지역사랑상품권 업종별 결제 (전국 소비 보조지표)
# https://www.data.go.kr/data/15149767/openapi.do
# 이 서비스 전용 일반 인증키를 사용한다. 인코딩·디코딩 형태 모두 처리한다.
LOCAL_GIFT_CARD_API_KEY=your-data-go-kr-service-key

# 제주 데이터허브 (제주 매물 전용)
JEJU_DATA_HUB_KEY=your-jeju-data-hub-key

# 로컬 에이전트
AGENT_KEY=re_agent_xxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENT_NAME=MyPC-Agent

# 네이버 로그인 (블로그 자동 업로드용)
NAVER_ID=your-naver-id
NAVER_PW=your-naver-password

# 구글 로그인 (유튜브 자동 업로드용)
GOOGLE_EMAIL=your-google-email@gmail.com
GOOGLE_PW=your-google-password

# 앱 설정
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RealEstate AI OS
